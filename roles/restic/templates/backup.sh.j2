#!/bin/sh
# OpenClaw backup script - generated by Ansible, do not edit by hand.
set -eu

LOCK={{ restic_lock_path | quote }}

# Serialise backup, prune, and check with a process-level lock.
exec 9>"$LOCK"
flock -n 9 || { echo 'ERROR: another restic operation is already running' >&2; exit 1; }

# Validate the repository is accessible.  Treat any non-"not found" error as a
# hard failure so that corruption or credential problems surface immediately
# rather than silently initialising a second repository.
restic_exit=0
restic snapshots >/dev/null 2>&1 || restic_exit=$?
if [ "$restic_exit" -eq 10 ]; then
  # Exit code 10 means the repository does not exist; initialise it once.
  restic init
elif [ "$restic_exit" -ne 0 ]; then
  echo "ERROR: restic snapshots failed with exit code $restic_exit - resolve before backing up" >&2
  exit 1
fi
{% if restic_sqlite_paths %}
# Quiesce OpenClaw so SQLite WAL is flushed before snapshotting.
service_was_active=0
if systemctl is-active --quiet {{ restic_openclaw_service | quote }}; then
  service_was_active=1
  systemctl stop {{ restic_openclaw_service | quote }}
  # Restart the service regardless of backup outcome.
  trap 'systemctl start {{ restic_openclaw_service | quote }} || true' EXIT HUP INT TERM
fi
{% endif %}
restic backup{% for path in restic_backup_paths %} {{ path | quote }}{% endfor %} --tag openclaw-pi
{% if restic_sqlite_paths %}
if [ "$service_was_active" -eq 1 ]; then
  trap - EXIT HUP INT TERM
  systemctl start {{ restic_openclaw_service | quote }}
fi
{% endif %}
restic forget --tag openclaw-pi --keep-daily {{ restic_keep_daily }} --keep-weekly {{ restic_keep_weekly }} --keep-monthly {{ restic_keep_monthly }} --prune

