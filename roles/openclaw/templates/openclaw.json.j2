{
  "gateway":{"mode":"local","bind":{{ openclaw_gateway_bind | to_json }},"port":{{ openclaw_gateway_port }},"auth":{"mode":"token","token":"${OPENCLAW_GATEWAY_TOKEN}"}},
  "models":{"mode":"merge","providers":{
{% if inference_backend == 'ollama' %}
    "ollama":{"baseUrl":{{ inference_base_url | to_json }},"apiKey":"ollama-local","api":"ollama","timeoutSeconds":{{ inference_timeout_seconds }},"models":[{"id":{{ inference_model | to_json }},"name":{{ inference_model | to_json }},"contextWindow":{{ inference_context_window }},"maxTokens":{{ inference_max_tokens }}}]},
{% else %}
    {{ openclaw_provider_id | to_json }}:{"baseUrl":{{ inference_base_url | to_json }},"apiKey":"${INFERENCE_API_KEY}","api":"openai-completions","timeoutSeconds":{{ inference_timeout_seconds }},"models":[{"id":{{ inference_model | to_json }},"name":{{ inference_model | to_json }},"reasoning":false,"input":["text"],"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0},"contextWindow":{{ inference_context_window }},"maxTokens":{{ inference_max_tokens }}}]},
{% endif %}
    "openrouter":{"models":[{"id":{{ openrouter_model_ref | to_json }},"name":{{ openrouter_model_name | to_json }}}]}
  }},
  "agents":{"defaults":{"workspace":{{ openclaw_workspace_dir | to_json }},"skipBootstrap":true,"model":{"primary":{{ (('ollama' if inference_backend == 'ollama' else openclaw_provider_id) ~ '/' ~ inference_model) | to_json }}},"models":{ {{ (('ollama' if inference_backend == 'ollama' else openclaw_provider_id) ~ '/' ~ inference_model) | to_json }}:{},{{ openrouter_model_ref | to_json }}:{"alias":{{ openrouter_model_name | to_json }}}},"sandbox":{"mode":{{ sandbox_mode | to_json }},"backend":"docker","scope":{{ sandbox_scope | to_json }},"workspaceAccess":{{ sandbox_workspace_access | to_json }},"docker":{"image":{{ sandbox_image | to_json }},"readOnlyRoot":true,"tmpfs":["/tmp","/var/tmp","/run"],"network":{{ sandbox_network | to_json }},"user":"1000:1000","capDrop":["ALL"],"pidsLimit":{{ sandbox_pids_limit }},"memory":{{ sandbox_memory | to_json }},"memorySwap":{{ sandbox_memory_swap | to_json }},"cpus":{{ sandbox_cpus }},"ulimits":{"nofile":{"soft":{{ sandbox_nofile_soft }},"hard":{{ sandbox_nofile_hard }}}}},"prune":{"idleHours":24,"maxAgeDays":7}}}}
}
