{
  "gateway": {
    "mode": "local",
    "bind": {{ openclaw_gateway_bind | to_json }},
    "port": {{ openclaw_gateway_port }},
    "auth": {
      "mode": "token",
      "token": {
        "source": "file",
        "provider": "gateway_token_file",
        "id": "/GATEWAY_AUTH_TOKEN"
      }
    },
    "controlUi": {
      "allowedOrigins": {{ openclaw_control_ui_allowed_origins | to_json }}
    }
  },
  "secrets": {
    "providers": {
      "gateway_token_file": {
        "source": "file",
        "path": {{ openclaw_gateway_token_file | to_json }},
        "mode": "json"
      }{% if inference_backend == 'ollama' and inference_base_url == 'https://ollama.gromer.dev' %},
      "ollama_caddy_file": {
        "source": "file",
        "path": {{ ollama_token_file | to_json }},
        "mode": "json"
      }{% endif %}{% if firecrawl_secret_enabled %},
      "firecrawl_env": {
        "source": "env",
        "allowlist": ["FIRECRAWL_API_KEY"]
      }{% endif %}
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
{% if inference_backend == 'ollama' %}
      "ollama": {
        "baseUrl": {{ inference_base_url | to_json }},
        "api": "ollama",
        "apiKey": {% if inference_base_url == 'https://ollama.gromer.dev' %}{
          "source": "file",
          "provider": "ollama_caddy_file",
          "id": "/OLLAMA_CADDY_TOKEN"
        }{% else %}"ollama-local"{% endif %},
        "timeoutSeconds": {{ inference_timeout_seconds }},
        "models": [{
          "id": {{ inference_model | to_json }},
          "name": {{ inference_model | to_json }},
          "contextWindow": {{ inference_context_window }},
          "maxTokens": {{ inference_max_tokens }}
        }]
      }
{% else %}
      {{ openclaw_provider_id | to_json }}: {
        "baseUrl": {{ inference_base_url | to_json }},
        "api": "openai-completions",
        "apiKey": "${INFERENCE_API_KEY}",
        "timeoutSeconds": {{ inference_timeout_seconds }},
        "models": [{
          "id": {{ inference_model | to_json }},
          "name": {{ inference_model | to_json }},
          "contextWindow": {{ inference_context_window }},
          "maxTokens": {{ inference_max_tokens }}
        }]
      }
{% endif %}
    }
  },
  "agents": {
    "defaults": {
      "workspace": {{ openclaw_workspace_dir | to_json }},
      "skipBootstrap": true,
      "model": {
        "primary": {{ (('ollama' if inference_backend == 'ollama' else openclaw_provider_id) ~ '/' ~ inference_model) | to_json }}
      },
      "models": {
        {{ (('ollama' if inference_backend == 'ollama' else openclaw_provider_id) ~ '/' ~ inference_model) | to_json }}: {}
      },
      "sandbox": {
        "mode": {{ sandbox_mode | to_json }},
        "backend": "docker",
        "scope": {{ sandbox_scope | to_json }},
        "workspaceAccess": {{ sandbox_workspace_access | to_json }},
        "docker": {
          "image": {{ sandbox_image | to_json }},
          "readOnlyRoot": true,
          "tmpfs": ["/tmp", "/var/tmp", "/run"],
          "network": {{ sandbox_network | to_json }},
          "user": "1000:1000",
          "capDrop": ["ALL"],
          "pidsLimit": {{ sandbox_pids_limit }},
          "memory": {{ sandbox_memory | to_json }},
          "memorySwap": {{ sandbox_memory_swap | to_json }},
          "cpus": {{ sandbox_cpus }},
          "ulimits": {
            "nofile": {
              "soft": {{ sandbox_nofile_soft }},
              "hard": {{ sandbox_nofile_hard }}
            }
          }
        },
        "prune": {"idleHours": 24, "maxAgeDays": 7}
      }
    }
  }{% if firecrawl_secret_enabled %},
  "plugins": {
    "entries": {
      "firecrawl": {
        "config": {
          "webSearch": {
            "apiKey": {
              "source": "env",
              "provider": "firecrawl_env",
              "id": "FIRECRAWL_API_KEY"
            }
          }
        }
      }
    }
  }{% endif %}
}
