[Unit]
Description=OpenClaw Gateway
[Service]
Type=simple
EnvironmentFile={{ openclaw_environment_path }}
ExecStart={{ openclaw_npm_prefix }}/bin/openclaw gateway run --port {{ openclaw_gateway_port }}
Restart=always
RestartSec=5s
UMask=0077
NoNewPrivileges=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
{% if firecrawl_secret_enabled %}EnvironmentFile={{ firecrawl_environment_path }}
{% endif %}
[Install]
WantedBy=default.target

