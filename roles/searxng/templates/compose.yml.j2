services:
  searxng:
    image: {{ searxng_image }}
    restart: unless-stopped
    ports:
      - "{{ searxng_bind_address }}:{{ searxng_port }}:8080"
    volumes:
      - "{{ searxng_config_dir }}/settings.yml:/etc/searxng/settings.yml:ro"
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=64m
    cap_drop: [ALL]
    security_opt: ["no-new-privileges:true"]
    pids_limit: 128
    mem_limit: 512m
    cpus: 1.0
    healthcheck:
      test: [CMD-SHELL, "wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 5
    logging:
      driver: json-file
      options: {max-size: 10m, max-file: "3"}
